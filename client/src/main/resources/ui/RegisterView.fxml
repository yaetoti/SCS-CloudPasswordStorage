<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="root" stylesheets="@login.css" prefWidth="400" prefHeight="500" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.RegisterView">
  <top>
    <MenuBar BorderPane.alignment="CENTER">
      <Menu mnemonicParsing="false" text="Menu">
        <MenuItem text="About" onAction="#onActionAbout"/>
      </Menu>
    </MenuBar>
  </top>
  <center>
    <VBox alignment="CENTER" prefWidth="375.0" spacing="10">
      <Label styleClass="mainLabel" text="SIGN UP">
            <VBox.margin>
               <Insets bottom="40.0" />
            </VBox.margin></Label>
      <TextField fx:id="loginField" promptText="Login" styleClass="loginField" />
      <PasswordField fx:id="passwordField" promptText="Password" styleClass="passwordField" />
      <Button fx:id="mainButton" onAction="#handleRegister" styleClass="mainButton" text="Sign up">
            <VBox.margin>
               <Insets top="20.0" />
            </VBox.margin></Button>
      <Button fx:id="secondaryButton" onAction="#handleLogin" styleClass="secondaryButton" text="Have an account?" />
    </VBox>
  </center>
</BorderPane>
